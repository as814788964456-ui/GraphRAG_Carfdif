# Claude API（也可改用 `ant auth login`，則此行可不填）
ANTHROPIC_API_KEY=sk-ant-...

# 各階段用哪個 LLM：claude 或 ollama
# 例：Claude 建圖譜 + 本地 Llama 問答 → EXTRACT_PROVIDER=claude、QA_PROVIDER=ollama
# QA_PROVIDER=ollama 時只能用 --simple 問答
EXTRACT_PROVIDER=claude
QA_PROVIDER=claude
OLLAMA_MODEL=taide
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=8192

# Claude 模型設定（effort：low | medium | high | xhigh | max）
# 建圖譜：抽取實體與關係
EXTRACT_MODEL=claude-opus-5-5
EXTRACT_EFFORT=low
# Smart Search 問答：多輪檢索、寫 Cypher、多跳推理
QA_MODEL=claude-opus-5-5
QA_EFFORT=high
# --simple 問答：根據檢索結果直接回答
SIMPLE_QA_MODEL=claude-opus-5-5
SIMPLE_QA_EFFORT=medium
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
# 空白 = 自動；用本地 LLM 時若顯存不足，設成 cpu
EMBED_DEVICE=

# Neo4j（AuraDB 請改成 neo4j+s://xxxx.databases.neo4j.io）
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag-password
NEO4J_DATABASE=neo4j

# 切塊設定（字元數，適合中文）
CHUNK_SIZE=800
CHUNK_OVERLAP=100
